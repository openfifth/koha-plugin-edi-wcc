[% INCLUDE 'doc-head-open.inc' %]
<title>EDI Service Charges (WCC) configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>

<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">Home</a>
    &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
    &rsaquo; EDI Service Charges (WCC)
    &rsaquo; Configure
</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                <h1>EDI Service Charges (WCC)</h1>

                <form method="post">
                    <input type="hidden" name="class" value="[% CLASS %]" />
                    <input type="hidden" name="method" value="[% METHOD %]" />
                    <input type="hidden" name="save" value="1" />
                    <input type="hidden" name="csrf_token" value="[% csrf_token %]" />

                    <fieldset class="rows">
                        <legend>Run options</legend>
                        <ol>
                            <li>
                                <label for="dry_run">Dry-run by default:</label>
                                <input type="checkbox" id="dry_run" name="dry_run" value="1" [% IF dry_run %]checked="checked"[% END %] />
                                <span class="hint">When enabled, scheduled runs only log what would happen and make no database changes.</span>
                            </li>
                            <li>
                                <label for="verbose">Verbose output:</label>
                                <input type="checkbox" id="verbose" name="verbose" value="1" [% IF verbose %]checked="checked"[% END %] />
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="rows">
                        <legend>Vendor-to-budget mappings</legend>
                        <p class="hint">
                            Map vendor name prefixes to acquisition funds. Service charge adjustments
                            will be posted to the matched fund. Entries are tested in order; the first
                            prefix that matches the start of the vendor name wins. Matching is
                            case-insensitive and the prefix must align to a word boundary.
                        </p>
                        <table id="budget-map-table" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Vendor name prefix</th>
                                    <th>Fund</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="budget-map-rows">
                                [% FOR mapping IN mappings %]
                                <tr class="budget-map-row">
                                    <td>
                                        <input type="text" name="vendor_prefix"
                                               value="[% mapping.vendor_prefix | html %]"
                                               class="form-control" placeholder="e.g. WCC" />
                                    </td>
                                    <td>
                                        <select name="budget_id" class="form-select">
                                            <option value="">-- select fund --</option>
                                            [% FOR budget IN budget_list %]
                                            <option value="[% budget.id %]"
                                                [% IF mapping.budget_id == budget.id %]selected="selected"[% END %]>
                                                [% budget.name | html %] ([% budget.code | html %])
                                            </option>
                                            [% END %]
                                        </select>
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-xs remove-row">Remove</button>
                                    </td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>
                        <button type="button" id="add-mapping-row" class="btn btn-default btn-sm">+ Add mapping</button>
                    </fieldset>

                    <fieldset class="action">
                        <input type="submit" value="Save configuration" />
                        <a href="/cgi-bin/koha/plugins/plugins-home.pl" class="cancel">Cancel</a>
                    </fieldset>
                </form>
            </main>
        </div>
    </div>
</div>

<template id="budget-map-row-template">
    <tr class="budget-map-row">
        <td>
            <input type="text" name="vendor_prefix" value=""
                   class="form-control" placeholder="e.g. WCC" />
        </td>
        <td>
            <select name="budget_id" class="form-select">
                <option value="">-- select fund --</option>
                [% FOR budget IN budget_list %]
                <option value="[% budget.id %]">[% budget.name | html %] ([% budget.code | html %])</option>
                [% END %]
            </select>
        </td>
        <td>
            <button type="button" class="btn btn-danger btn-xs remove-row">Remove</button>
        </td>
    </tr>
</template>

<script>
$(document).ready(function () {
    $('#budget-map-rows').on('click', '.remove-row', function () {
        $(this).closest('tr').remove();
    });

    $('#add-mapping-row').on('click', function () {
        var tpl = document.getElementById('budget-map-row-template');
        var clone = document.importNode(tpl.content, true);
        document.getElementById('budget-map-rows').appendChild(clone);
    });
});
</script>

[% INCLUDE 'intranet-bottom.inc' %]
